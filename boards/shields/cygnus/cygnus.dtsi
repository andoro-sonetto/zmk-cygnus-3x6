#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,kscan = &kscan0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;

        bindings = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
                            RC(4,3) RC(4,4) RC(4,5)            RC(4,5) RC(4,4) RC(4,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        // 【行】XIAOのピン（A0〜A4）に実質5行で割り当て
        row-gpios
            = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A0 (Row0)
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A1 (Row1)
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A2 (Row2)
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A3 (Row3)
            , <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // A4 (Row4 / 親指)
            ;

        // 【列】XIAOのピン（A5〜D10）に6列で割り当て
        col-gpios
            = <&gpio0 5  GPIO_ACTIVE_HIGH> // A5  (Col0)
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // D6  (Col1)
            , <&gpio1 12 GPIO_ACTIVE_HIGH> // D7  (Col2)
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // D8  (Col3)
            , <&gpio1 14 GPIO_ACTIVE_HIGH> // D9  (Col4)
            , <&gpio1 15 GPIO_ACTIVE_HIGH> // D10 (Col5)
            ;
    };
};
