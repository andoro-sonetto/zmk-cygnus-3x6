#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,kscan = &kscan0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
                            RC(4,3) RC(4,4) RC(4,5)            RC(4,5) RC(4,4) RC(4,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        // 【行：イラストの7〜11番】XIAOのピンへ割り当て
        row-gpios
            = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 7番ピン (XIAO D6)➔Row0
            , <&gpio1 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 8番ピン (XIAO D8)➔Row1
            , <&gpio1 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 9番ピン (XIAO D9)➔Row2
            , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 10番ピン(XIAO D10)➔Row3
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 11番ピン(XIAO A1) ➔Row4
            ;

        // 【列：イラストの1〜6番】XIAOのピンへ割り当て
        col-gpios
            = <&gpio0 2  GPIO_ACTIVE_HIGH> // 1番ピン (XIAO A0) ➔Col0
            , <&gpio0 28 GPIO_ACTIVE_HIGH> // 2番ピン (XIAO A2) ➔Col1
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // 3番ピン (XIAO A3) ➔Col2
            , <&gpio0 4  GPIO_ACTIVE_HIGH> // 4番ピン (XIAO A4) ➔Col3
            , <&gpio0 5  GPIO_ACTIVE_HIGH> // 5番ピン (XIAO A5) ➔Col4
            , <&gpio1 0  GPIO_ACTIVE_HIGH> // 6番ピン (XIAO D7) ➔Col5
            ;
    };
};
