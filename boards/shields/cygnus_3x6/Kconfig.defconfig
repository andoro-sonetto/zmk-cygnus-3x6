if SHIELD_CYGNUS_3X6_LEFT

config ZMK_KEYBOARD_NAME
    default "Cygnus 3x6"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

endif

if SHIELD_CYGNUS_3X6_RIGHT

config ZMK_KEYBOARD_NAME
    default "Cygnus 3x6"

endif

if SHIELD_CYGNUS_3X6_LEFT || SHIELD_CYGNUS_3X6_RIGHT

config ZMK_SPLIT
    default y

endif
