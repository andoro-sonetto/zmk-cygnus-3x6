#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// レイヤー名に番号（ID）を割り当て
#define DEFAULT 0
#define NUMBER  1
#define FUNC    2
#define MOUSE   3
#define BLE     4

/ {
    keymap {
        compatible = "zmk,keymap";

        // レイヤー 0 : デフォルト (アルファベット)
        default_layer {
            bindings = <
                &kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T                           &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G                           &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B                           &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LSHFT &none  &none  &none  &none  &none                           &none  &none  &none     &none   &none    &kp ENTER
                                &mo NUMBER &kp LALT &kp SPACE               &kp ENTER &kp RALT &mo FUNC
            >;
        };

        // レイヤー 1 : 数字・記号 (左親指ホールドで切り替え)
        number_layer {
            bindings = <
                &kp TILD  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT                       &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp DEL
                &trans    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                          &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp PLUS
                &trans    &none    &none    &none    &none    &none                           &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &trans
                &trans    &none    &none    &none    &none    &none                           &none     &none    &none     &none     &mo BLE   &trans
                                            &trans   &trans   &trans                  &trans    &trans    &mo MOUSE
            >;
        };

        // レイヤー 2 : ファンクション・矢印 (右親指ホールドで切り替え)
        func_layer {
            bindings = <
                &kp F1    &kp F2   &kp F3   &kp F4   &kp F5   &kp F6                          &kp HOME  &kp PG_DN &kp PG_UP &kp END   &none     &trans
                &kp F7    &kp F8   &kp F9   &kp F10  &kp F11  &kp F12                         &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &none     &none
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &trans
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &trans
                                            &mo MOUSE &trans  &trans                  &trans    &trans    &trans
            >;
        };

        // レイヤー 3 : マウス（キーボードによるカーソル移動・クリック用）
        mouse_layer {
            bindings = <
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &trans
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &none
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &trans
                &trans    &none    &none    &none    &none    &none                           &none     &none     &none     &none     &none     &trans
                                            &trans   &trans   &trans                  &trans    &trans    &trans
            >;
        };

        // レイヤー 4 : BT (Bluetooth接続切り替え / 数字レイヤー中に右端のキーでアクセス)
        ble_layer {
            bindings = <
                &bt BT_CLR &none        &none        &none        &none        &none                           &none        &none        &none        &none        &none        &none
                &none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &none        &none        &none        &none        &none        &none
                &none      &none        &none        &none        &none        &none                           &none        &none        &none        &none        &none        &none
                &none      &none        &none        &none        &none        &none                           &none        &none        &none        &none        &none        &none
                                                     &trans       &trans       &trans                  &trans  &trans       &trans
            >;
        };
    };
};
