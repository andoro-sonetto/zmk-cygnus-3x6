#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NUMBER  1
#define FUNC    2
#define BLE     3

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: デフォルト（Corne風 3x6）
        default_layer {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T            &kp Y  &kp U  &kp I     &kp O   &kp P     &kp BSPC
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G            &kp H  &kp J  &kp K     &kp L   &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B            &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH  &kp RSHFT
                                    &kp LGUI &mt LALT LANG2 &lt NUMBER SPACE    &lt FUNC ENTER &mt RALT LANG1 &kp RGUI
            >;
        };

        // 1: 数字・記号（左親指ホールド）
        number_layer {
            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5          &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &trans     &kp GRAVE &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp BSLH  &trans
                &trans     &none     &none     &none     &none     &none           &kp HOME  &kp PG_DN &kp PG_UP &kp END   &mo BLE   &trans
                                    &trans    &trans    &trans                           &trans    &trans    &trans
            >;
        };

        // 2: ファンクション・メディア（右親指ホールド）
        func_layer {
            bindings = <
                &kp F1     &kp F2   &kp F3   &kp F4   &kp F5   &kp F6          &kp F7      &kp F8       &kp F9      &kp F10     &kp F11    &kp F12
                &trans     &none    &none    &none    &none    &none           &kp C_PREV  &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP   &trans
                &trans     &none    &none    &none    &none    &none           &none       &none        &none       &none       &none      &trans
                                    &trans   &trans   &trans                         &trans      &trans       &trans
            >;
        };

        // 3: BLE（NUMBERレイヤー上の &mo BLE から）
        ble_layer {
            bindings = <
                &bt BT_CLR &none        &none        &none        &none        &none           &none &none &none &none &none &none
                &none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &none
                &none      &none        &none        &none        &none        &none           &none &none &none &none &none &none
                                    &trans       &trans       &trans                         &trans &trans &trans
            >;
        };
    };
};
